{
  "info": {
    "name": "FinTrack API",
    "description": "Auth flow (register/login), contoh request terproteksi, dan contoh blocked-request (403) untuk ownership/RBAC enforcement.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "apiKey", "value": "RevoU2026" },
    { "key": "accessToken", "value": "" },
    { "key": "otherUserAccountId", "value": "1" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('accessToken', pm.response.json().access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('accessToken', pm.response.json().access_token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Protected requests (pakai accessToken)",
      "item": [
        {
          "name": "GET /accounts (milik sendiri)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-api", "value": "{{apiKey}}" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] }
          }
        },
        {
          "name": "POST /accounts (buat akun sendiri)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api", "value": "{{apiKey}}" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 1,\n  \"name\": \"Bank Saya\",\n  \"type\": \"bank\",\n  \"balance\": 1000000\n}"
            },
            "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] }
          }
        }
      ]
    },
    {
      "name": "3. Blocked-request examples (expect 401/403/429)",
      "item": [
        {
          "name": "GET /accounts tanpa token -> 401",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api", "value": "{{apiKey}}" }],
            "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"] }
            }
          ]
        },
        {
          "name": "GET akun milik user lain -> 403 (ownership)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-api", "value": "{{apiKey}}" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{otherUserAccountId}}",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{otherUserAccountId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('403 Forbidden', () => pm.response.to.have.status(403));"] }
            }
          ]
        },
        {
          "name": "POST /categories sebagai role User -> 403 (RBAC)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api", "value": "{{apiKey}}" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kategori Baru\",\n  \"type\": \"expense\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('403 Forbidden (bukan Admin)', () => pm.response.to.have.status(403));"] }
            }
          ]
        },
        {
          "name": "Login berulang (6x+) -> 429 (rate limit)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"salah\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "description": "Jalankan request ini berulang kali (Postman Runner, 7x) dalam <60 detik untuk memicu 429 Too Many Requests."
        }
      ]
    }
  ]
}
